{
  "name": "trelio-digital-assistants",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:git-coordination",
    "worktree:bootstrap": "bash scripts/bootstrap-worktree-dependencies.sh",
    "check:dependencies": "bash scripts/bootstrap-worktree-dependencies.sh --check",
    "check:worktree": "bash scripts/assert-clean-worktree.sh",
    "git:configure-main": "bash scripts/configure-canonical-main.sh",
    "git:new-worktree": "bash scripts/create-task-worktree.sh",
    "git:finish-worktree": "node scripts/git-finish-worktree.mjs",
    "git:check-finished-worktrees": "node scripts/git-finish-worktree.mjs --check",
    "git:push-main": "bash scripts/push-main.sh",
    "git:integrate": "node scripts/git-integrate.mjs",
    "test:git-coordination": "node --test scripts/git-coordination.test.mjs"
  },
  "devDependencies": {
    "@trelio/git-coordinator": "git+https://github.com/trelio-ru/agent-workspaces-runtime.git#6cdbf5d2123711c7345ea1bda31ef0395b1d54d1",
    "tiktoken": "1.0.22"
  }
}
